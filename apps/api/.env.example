APP_ENV=development
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
SESSION_SECRET=replace-with-a-long-random-secret
PIN_PEPPER=replace-with-a-long-random-pepper
# Keep public registration enabled. Set false only to pause new account creation.
ALLOW_SIGNUP=true
INTEGRATION_ENCRYPTION_KEY=generate-a-fernet-key
NOTION_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/v1/integrations/google-calendar/oauth/callback
GOOGLE_GMAIL_REDIRECT_URI=http://127.0.0.1:8000/api/v1/integrations/gmail/oauth/callback
WEB_ORIGIN=http://127.0.0.1:3000
