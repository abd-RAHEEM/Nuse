APP_ENV=development
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
SESSION_SECRET=replace-with-a-long-random-secret
PIN_PEPPER=replace-with-a-long-random-pepper
# First-account bootstrap: the API permits signup only while the users table
# is empty, then disables signup automatically.
ALLOW_SIGNUP=true
INTEGRATION_ENCRYPTION_KEY=generate-a-fernet-key
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/v1/integrations/google-calendar/oauth/callback
WEB_ORIGIN=http://127.0.0.1:3000
